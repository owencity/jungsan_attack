+    }
+
+    private fun payoutValue(value: Any?): Any? = (value as? ByteArray)?.let { mapper.readValue(cipher.decrypt(it),Map::class.java) }
+    fun payout(uid: Long,request: PayoutRequest): Map<String,Any?> {
