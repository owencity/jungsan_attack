++import uuid
++import zipfile
++
++BASE = "http://127.0.0.1:18081/api/v1"
++DATABASE = "jeongsan_auth_test"
++CONTAINER = "jeongsan-v4-verification"
++ROOT = Path(__file__).resolve().parent.parent
