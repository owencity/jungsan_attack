++"""CI 전용 MySQL에서 Boot 3의 저장 데이터·토큰을 Boot 4가 이어 쓰는지 확인한다."""
++import argparse
++import base64
++import hashlib
++import hmac
++import json
++import os
++from pathlib import Path
++import subprocess
++import sys
++import time
++from urllib.error import HTTPError
