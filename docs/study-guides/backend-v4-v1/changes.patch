+               system_code VARCHAR(40) NULL COMMENT '이름 변경과 무관한 이벤트 종류',
+               body VARCHAR(500) NOT NULL COMMENT '생성 당시 실명으로 완성한 문장, 계좌번호는 넣지 않음',
+               created_at DATETIME(6) NOT NULL COMMENT 'UTC 생성 시각',
+               INDEX idx_timeline_room(gathering_id,id),
+               CONSTRAINT fk_timeline_room FOREIGN KEY(gathering_id) REFERENCES gatherings(id)
+              ) COMMENT='단위가 달라도 같은 술자리에서 읽는 한 줄 타임라인';
+              CREATE TABLE notifications (
+               id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY COMMENT '내부 알림 식별자',
+               user_id BIGINT NOT NULL COMMENT '알림 소유자',
+               gathering_id BIGINT NOT NULL COMMENT '술자리 삭제 시 함께 제거하는 개인정보',
+               settlement_unit_id BIGINT NULL COMMENT '단위별 이동과 알림 범위',
+               type VARCHAR(40) NOT NULL COMMENT 'SETTLED SENT NOT_RECEIVED 등 프론트 이동 기준',
+               title VARCHAR(100) NOT NULL COMMENT '요약 안내 문구',
+               body VARCHAR(500) NOT NULL COMMENT '이벤트 당시 실명과 금액 안내',
+               created_at DATETIME(6) NOT NULL COMMENT '최신순 조회 기준',
+               read_at DATETIME(6) NULL COMMENT '본인 읽음 처리',
+               INDEX idx_notification_user(user_id,id),
+               CONSTRAINT fk_notification_room FOREIGN KEY(gathering_id) REFERENCES gatherings(id)
+              ) COMMENT='이번 출시에는 푸시 없이 내부 알림함을 제공 FC-014';
+              ALTER TABLE users ADD payout_encrypted VARBINARY(512) NULL COMMENT 'AES-GCM 인증 암호문, 원문 계좌를 DB에 저장하지 않음',
+               ADD spoon_count BIGINT NOT NULL DEFAULT 0 COMMENT '술자리 삭제 후에도 남는 감사 표시 누적';
