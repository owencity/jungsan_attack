++        BigInteger grandTotal = rounds.stream().map(round -> BigInteger.valueOf(round.total()))
++                .reduce(BigInteger.ZERO, BigInteger::add);
++        if (grandTotal.compareTo(MAX_AMOUNT_BIG) > 0) {
