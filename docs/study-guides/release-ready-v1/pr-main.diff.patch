+    }
+    fun message(gid: Long,uid: Long,request: MessageRequest): Map<String,Any?> {
+        val p=person(gid,uid);val text=request.text.trim();if(text.isEmpty()||text.length>200) fail("MALFORMED_REQUEST",status=HttpStatus.BAD_REQUEST)
