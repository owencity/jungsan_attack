++                if (!input.attendance().containsKey(new AttendanceKey(participant.id(), round.id()))) {
++                    errors.add(new ValidationError(ErrorCode.MISSING_ATTENDANCE,
++                            round.label() + "에 '" + participant.name() + "'의 응답이 없습니다.", round.id(), participant.id()));
++                }
++            }
