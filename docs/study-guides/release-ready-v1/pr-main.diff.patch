+-                    role = it.role,
+-                )
+-            },
+-            gatherings = gatheringRepository.findByGroupIdOrderByGatheringDateDesc(groupId).map {
+-                GroupGatheringResponse(id = it.id, name = it.name, date = it.gatheringDate, status = it.status)
+-            },
+-        )
+-    }
+-}
