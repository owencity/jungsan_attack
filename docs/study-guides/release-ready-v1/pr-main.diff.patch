+-    var groupId: Long = 0,
+-
+-    @Column(name = "user_id")
+-    var userId: Long = 0,
+-) : Serializable
+-
+-enum class GroupRole {
+-    /** 모임을 만든 사람. 멤버 제거 등 관리 기능을 쓸 수 있고, 자기 자신은 못 뺀다. */
+-    OWNER,
+-    MEMBER,
+-}
