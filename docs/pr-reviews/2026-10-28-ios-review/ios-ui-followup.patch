 ## 출시 검증
 
 - 로컬 Android debug APK 빌드와 공통 단위 테스트210건 통과(실패·건너뜀0). 마지막 변경 후 재검증 결과는 PR에 기록한다.
-- macOS CI에서 실기기 타깃 Kotlin 컴파일, Swift/시뮬레이터 앱 빌드, 실행·데모 딥링크와 스크린샷을 확인한다. CI 성공을 실제 iPhone 로그인 성공으로 간주하지 않는다.
+- macOS CI에서 실기기 타깃 Kotlin 컴파일, Swift/시뮬레이터 앱 빌드·실행 후 XCTest가 데모 버튼·역할 전환·초기화·종료를 실제로 누르고 화면을 검사한다. 스크린샷을 결과에 보존한다. `simctl openurl`만으로는 시스템의 앱 열기 확인창에서 멈출 수 있어 이를 데모 진입 성공으로 간주하지 않는다. CI 성공을 실제 iPhone 로그인 성공으로 간주하지 않는다.
 - 새 TestFlight 빌드는 실제 API 주소 `https://jungsan-api.devkdk.com`를 지정한다. API 주소 공백은 기존 전체 목데이터 모드이므로 출시 설정으로 사용하지 않는다.
 - 제출 전 실제 iPhone에서 양쪽 제공자 로그인·취소·재시도, 데모 역할 전환/초기화/공유 링크, 실제 계정 로그아웃·탈퇴를 확인한다.
 - App Store Connect에는 새 빌드 번호, 위 진입·역할 전환 절차와 실제로 제공되는 기능/제한을 적는다. 제출·심사 통과는 빌드 성공과 별개다.
diff --git a/iosApp/iosAppUITests/AppReviewUITests.swift b/iosApp/iosAppUITests/AppReviewUITests.swift
new file mode 100644
index 0000000..6cbbfcd
--- /dev/null
+++ b/iosApp/iosAppUITests/AppReviewUITests.swift
@@ -0,0 +1,51 @@
+import XCTest
+
+final class AppReviewUITests: XCTestCase {
+    private let application = XCUIApplication()
+
+    private func element(_ label: String) -> XCUIElement {
+        application.descendants(matching: .any)
+            .matching(NSPredicate(format: "label == %@", label)).firstMatch
+    }
+
+    private func expect(_ label: String) {
+        XCTAssertTrue(element(label).waitForExistence(timeout: 20), "Missing visible UI: \(label)")
+    }
+
+    private func capture(_ name: String) {
+        let attachment = XCTAttachment(screenshot: application.screenshot())
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+    }
+
+    func testPublicDemoRolesResetAndExit() {
+        continueAfterFailure = false
+        executionTimeAllowance = 180
+        application.launch()
+        XCTAssertTrue(application.descendants(matching: .any)
+            .matching(NSPredicate(format: "label ENDSWITH %@", "Apple로 계속하기"))
+            .firstMatch.waitForExistence(timeout: 20))
+        expect("로그인 없이 데모 체험")
+        capture("ios-login")
+        element("로그인 없이 데모 체험").tap()
+        expect("데모 체험 · 가상 데이터 · 실제 송금 없음")
+        expect("정산방에서 쓸 이름")
+        element("참여자A").tap()
+        expect("내 술자리")
+        expect("체험 · 응답 중")
+        expect("체험 · 입금 확인 중")
+        capture("ios-demo-role-a")
+        element("참여자B").tap()
+        expect("✓ 참여자B")
+        expect("1차 응답을 남겨주세요")
+        capture("ios-demo-role-b")
+        element("처음부터").tap()
+        expect("✓ 체험총무")
+        expect("정산방에서 쓸 이름")
+        capture("ios-demo-reset")
+        element("체험 종료").tap()
+        expect("로그인 없이 데모 체험")
+        XCTAssertFalse(element("데모 체험 · 가상 데이터 · 실제 송금 없음").exists)
+    }
+}
